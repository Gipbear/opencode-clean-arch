{
  "clean-arch-readonly-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./dist/agy-hooks.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
