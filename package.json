{
  "name": "opencode-clean-arch",
  "version": "0.4.1",
  "description": "opencode plugin: skills and tools that turn agent-grown Python code into a clean, documented architecture (diagnose, reviewed plan, restructure, simplify, leftover gate, 4+1 docs with SVG diagrams).",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "clean-arch": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "plugin.json",
    "mcp_config.json",
    "hooks.json",
    "rules",
    "assets",
    "!**/__pycache__",
    "!**/*.test.ts",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "skills",
    "refactoring",
    "architecture",
    "python"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gipbear/opencode-clean-arch.git"
  },
  "homepage": "https://github.com/Gipbear/opencode-clean-arch#readme",
  "bugs": {
    "url": "https://github.com/Gipbear/opencode-clean-arch/issues"
  },
  "engines": {
    "opencode": ">=1.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/run-tests.mjs && python3 -m unittest discover -s tests/python -t .",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "beautiful-mermaid": "^1.1.3",
    "marked": "^18.2.0",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.16.0 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": ">=1.16.0 <2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
